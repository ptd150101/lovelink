# Native backend development while infrastructure runs in Docker Compose.
# Copy this file to .env.host and load it with `uv run --env-file ../.env.host ...`.

# Core
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database / Redis published from Docker Compose to the host
POSTGRES_DB=lovelink
POSTGRES_USER=lovelink
POSTGRES_PASSWORD=lovelink
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0

# Authentication abuse protection
LOGIN_IDENTITY_FAILURE_LIMIT=8
LOGIN_IDENTITY_IP_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Staff MFA
STAFF_MFA_REQUIRED=false
STAFF_MFA_ISSUER=LoveLink

# Observability
LOG_FORMAT=text
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Email and local phone OTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LoveLink <noreply@lovelink.local>
MESSAGE_NOTIFICATION_COALESCE_SECONDS=300
SMS_BACKEND=console
PHONE_DEFAULT_COUNTRY_CODE=84
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_DAILY_LIMIT=5
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_FIXED_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# MinIO published from Docker Compose to the host
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PROFILE_BUCKET=profile-media
S3_VERIFICATION_BUCKET=verification-evidence-private
S3_REGION=auto

# LiveKit OSS running through Docker Compose host networking
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-123456

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/app
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
