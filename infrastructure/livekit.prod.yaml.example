# Production template for the self-hosted LiveKit OSS server.
# Replace every CHANGE_ME value and mount the certificate paths read-only.
port: 7880
bind_addresses:
  - "0.0.0.0"

rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: true

keys:
  CHANGE_ME_API_KEY: CHANGE_ME_LONG_RANDOM_API_SECRET

webhook:
  api_key: CHANGE_ME_API_KEY
  urls:
    - https://api.example.com/api/v1/webhooks/livekit

turn:
  enabled: true
  domain: turn.example.com
  tls_port: 5349
  udp_port: 3478
  cert_file: /etc/livekit/certs/fullchain.pem
  key_file: /etc/livekit/certs/privkey.pem

prometheus_port: 6789
logging:
  level: info
