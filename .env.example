# Core
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database / Redis
POSTGRES_DB=lovelink
POSTGRES_USER=lovelink
POSTGRES_PASSWORD=lovelink
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Email (console backend by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LoveLink <noreply@lovelink.local>

# Phone OTP / SMS
# `console` writes OTP messages to backend logs for local development.
# Set SMS_BACKEND=twilio and provide the Twilio values in production.
SMS_BACKEND=console
PHONE_DEFAULT_COUNTRY_CODE=84
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_DAILY_LIMIT=5
PHONE_OTP_MAX_ATTEMPTS=5
# Development and deterministic E2E only. Leave empty in production.
PHONE_OTP_FIXED_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Object storage (MinIO locally; S3/R2 compatible in production)
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PROFILE_BUCKET=profile-media
S3_VERIFICATION_BUCKET=verification-evidence-private
S3_REGION=auto

# LiveKit OSS
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WEBHOOK_URL=http://backend:8000/api/v1/webhooks/livekit
LIVEKIT_IMAGE=livekit/livekit-server:latest

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/app
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
